# See docs/API_KEYS.md for where to get each key and pricing details.

# Database
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel
POSTGRES_DB=travel
DATABASE_URL=postgresql+psycopg://travel:travel@postgres:5432/travel

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM
SILICONFLOW_API_KEY=your_siliconflow_api_key

# Web search + content extraction (free/low-cost)
SERPER_API_KEY=your_serper_api_key
TAVILY_API_KEY=your_tavily_api_key
JINA_AI_ENABLED=true
FIRECRAWL_API_KEY=your_firecrawl_api_key

# External data sources
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
XIAOHONGSHU_API_KEY=your_xiaohongshu_api_key_or_third_party_token
XIAOHONGSHU_API_BASE_URL=
XIAOHONGSHU_API_ENDPOINT=
TRIPADVISOR_API_KEY=your_tripadvisor_api_key
TIKHUB_API_KEY=your_tikhub_api_key
TIKHUB_XIAOHONGSHU_ENDPOINT=
STAYAPI_API_KEY=your_stayapi_api_key
DATAFORSEO_LOGIN=your_dataforseo_login
DATAFORSEO_PASSWORD=your_dataforseo_password
DIANPING_API_KEY=your_dianping_api_key
DIANPING_API_BASE_URL=
CTRIP_API_KEY=your_ctrip_api_key
CTRIP_API_BASE_URL=
BOOKING_AFFILIATE_ID=your_booking_affiliate_id
AGODA_API_KEY=your_agoda_api_key
FOURSQUARE_API_KEY=your_foursquare_api_key
APIFY_API_TOKEN=your_apify_api_token
BING_SEARCH_API_KEY=your_bing_search_api_key
YELP_API_KEY=your_yelp_api_key

# Logging
LOG_LEVEL=INFO
